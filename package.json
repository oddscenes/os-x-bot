{
  "name": "@oddscenes/os-x-bot",
  "version": "1.0.0",
  "description": "A configurable TypeScript X bot template for scheduled AI-assisted posting and engagement.",
  "main": "dist/scheduler.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/scheduler.js",
    "dev": "nodemon --watch src --ext ts --exec 'ts-node src/scheduler.ts'",
    "run-now": "ts-node src/bot.ts",
    "pm2": "npm run build && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop os-x-bot",
    "pm2:restart": "pm2 restart os-x-bot",
    "pm2:logs": "pm2 logs os-x-bot",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "x",
    "twitter",
    "bot",
    "openai",
    "automation",
    "odd-scenes"
  ],
  "author": "Odd Scenes",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "@types/p-retry": "^3.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "node-cron": "^3.0.3",
    "openai": "^4.95.1",
    "p-retry": "^6.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pm2": "^6.0.5",
    "twitter-api-v2": "^1.22.0"
  }
}
