# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="info"

# Set true while testing. When true, the bot logs intended actions instead of posting to X.
SIMULATE_MODE="true"

# --- Bot Identity ---
# Used only for AI voice/context. Posting identity comes from your X access tokens.
BOT_NAME="My X Bot"
BOT_HANDLE="@my_x_bot"

# --- TwitterAPI.io Search ---
# Used to find recent public posts to evaluate.
TWITTERAPI_IO_KEY=""

# --- Official X API Posting ---
# Required for posts, replies, reposts, and quote tweets.
X_APP_KEY=""
X_APP_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""

# --- OpenAI ---
OPENAI_API_KEY=""

# Defaults to gpt-5.5 in code. Set a lower-cost model here if preferred.
# Examples: gpt-5.5, gpt-5.4, gpt-5.4-mini
OPENAI_MODEL="gpt-5.5"

# --- Scheduler ---
# node-cron syntax. Default in src/scheduler.ts is "5 */8 * * *".
# Example: "0 9,15,21 * * *" runs at 09:00, 15:00, and 21:00 server time.
CRON_SCHEDULE="5 */8 * * *"

# --- Decision Tuning ---
ENGAGEMENT_REPLY_THRESHOLD="10"

CADENCE_MORNING_REPOSTS="2"
CADENCE_MORNING_ORIGINAL="2"
CADENCE_AFTERNOON_REPLIES="2"
CADENCE_AFTERNOON_ORIGINAL="1"
CADENCE_EVENING_REPLIES="1"
CADENCE_EVENING_REPOSTS="2"
CADENCE_EVENING_ORIGINAL="1"
CADENCE_LATE_NIGHT_REPLIES="0"
CADENCE_LATE_NIGHT_REPOSTS="0"
CADENCE_LATE_NIGHT_ORIGINAL="0"
